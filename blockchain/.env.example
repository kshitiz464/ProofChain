# Copy to blockchain/.env. Use a dedicated test wallet and test ETH only.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_PRIVATE_KEY=
# Number of anchor measurements (each public-network run spends test ETH).
BENCHMARK_SAMPLES=5
# Optional: use an existing deployed contract. Otherwise the benchmark deploys one.
BENCHMARK_CONTRACT_ADDRESS=

