# Copy to backend/.env. Keep credentials private.
PINATA_JWT=YOUR_PINATA_JWT
# Optional in a local demo; confirmed history is queued on disk while unavailable.
MONGO_URI=
# Local deploy fills in RPC_URL, SIGNER_PRIVATE_KEY, CHAIN_ID, CONTRACT_ADDRESS, DEPLOYMENT_ID.
RPC_URL=http://127.0.0.1:8545
SIGNER_PRIVATE_KEY=
CHAIN_ID=31337
CONTRACT_ADDRESS=
DEPLOYMENT_ID=legacy

PORT=5000
BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only behind a known reverse proxy that sanitizes forwarded headers.
# TRUST_PROXY_HOPS=1
MAX_FILE_SIZE_MB=50
UPLOAD_RATE_LIMIT=10
RATE_WINDOW_MS=60000
MAX_CONCURRENT_UPLOADS=2
IPFS_TIMEOUT_MS=60000
CONFIRMATION_TIMEOUT_MS=180000
# DATA_DIR=./data

